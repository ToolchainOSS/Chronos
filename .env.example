# Runtime environment for docker compose. Copy to .env and adjust as needed.
#
# Happy path: leave everything below at its default. Chronos downloads and
# caches the CAIDA AS-relationship dataset into the data directory on startup.
# The ./data host directory is mounted read-write at /data (see the compose
# file) and holds all cached and volatile runtime state.

CHRONOS_BIND_ADDR=0.0.0.0:8080
CHRONOS_RIS_URL=ws://ris-live.ripe.net/v1/ws/?client=chronos

# RIS Live subscription filters (server-side; unset = global firehose). These
# cut bandwidth and sharpen signal at the source. See the "Recommended filter
# configurations" section in README.md for full profiles.
#   Single vantage point (one collector, broad coverage, much less bandwidth):
# CHRONOS_RIS_HOST=rrc00
#   Watch your own network (any update whose AS path traverses your ASN):
# CHRONOS_RIS_PATH=64500
#   Defend your prefixes (only your prefix; add more-specific for hijack watch):
# CHRONOS_RIS_PREFIX=192.0.2.0/24
# CHRONOS_RIS_MORE_SPECIFIC=true
# CHRONOS_RIS_LESS_SPECIFIC=false

# Writable directory for cached datasets and volatile runtime state.
# CHRONOS_DATA_DIR=/data

# CAIDA AS relationships (auto-downloaded by default). Override precedence:
#   1. mount a file and point this at it (plain .txt or .bz2):
# CHRONOS_CAIDA_ASREL=/data/as-rel.txt
#   2. pin an exact dataset URL to fetch and cache (e.g. a point in time):
# CHRONOS_CAIDA_URL=https://publicdata.caida.org/datasets/as-relationships/serial-1/20260701.as-rel.txt.bz2
#   3. control auto-discovery (defaults shown):
# CHRONOS_CAIDA_AUTODOWNLOAD=true
# CHRONOS_CAIDA_BASE_URL=https://publicdata.caida.org/datasets/as-relationships/serial-1/

# GeoLite2 databases (licensed; mounted files, optional). When absent, geo
# region resolution is disabled and no AreaDegraded deltas are emitted.
# CHRONOS_GEOLITE2_CITY_DB=/data/GeoLite2-City.mmdb
# CHRONOS_GEOLITE2_ASN_DB=/data/GeoLite2-ASN.mmdb

# Persistent anomaly history (opt-in; disabled by default so the engine stays
# stateless and in-memory). When enabled, detected anomalies are recorded to
# PostgreSQL for a history / time-series view. Chronos bounds its own storage
# with a retention window plus a hard byte cap, so disk use stays bounded
# perpetually. Enterprises wanting unbounded, high-granularity metrics should
# instead scrape /metrics into their own Prometheus (outside this cap).
# Start the bundled database with: docker compose --profile history up
# CHRONOS_HISTORY_ENABLED=false
# CHRONOS_HISTORY_URL=postgres://chronos:chronos@postgres:5432/chronos
# CHRONOS_HISTORY_RETENTION_DAYS=30
# CHRONOS_HISTORY_MAX_BYTES=2147483648
# Advanced writer tuning (sensible defaults; rarely need changing):
# CHRONOS_HISTORY_BATCH_SIZE=500
# CHRONOS_HISTORY_FLUSH_SECS=2
# CHRONOS_HISTORY_PRUNE_SECS=3600
# CHRONOS_HISTORY_CHANNEL_BOUND=8192

# Optional tuning.
# CHRONOS_INGEST_CHANNEL_BOUND=16384
# CHRONOS_BROADCAST_CAPACITY=8192
# CHRONOS_EDGE_TTL_SECS=900
# CHRONOS_SWEEP_INTERVAL_SECS=60
# CHRONOS_DEGREE_RATIO=4.0
# RUST_LOG=info
