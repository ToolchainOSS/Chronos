# Runtime environment for docker compose. Copy to .env and adjust as needed.
# Data files are mounted read only from ./data on the host into /data in the
# container. These files are never committed to source control.

CHRONOS_BIND_ADDR=0.0.0.0:8080
CHRONOS_RIS_URL=ws://ris-live.ripe.net/v1/stream/?client=chronos

# Mounted data file paths (inside the container).
CHRONOS_GEOLITE2_CITY_DB=/data/GeoLite2-City.mmdb
CHRONOS_GEOLITE2_ASN_DB=/data/GeoLite2-ASN.mmdb
CHRONOS_CAIDA_ASREL=/data/as-rel.txt

# Optional tuning.
# CHRONOS_INGEST_CHANNEL_BOUND=16384
# CHRONOS_BROADCAST_CAPACITY=8192
# CHRONOS_EDGE_TTL_SECS=900
# CHRONOS_SWEEP_INTERVAL_SECS=60
# CHRONOS_DEGREE_RATIO=4.0
# RUST_LOG=info
